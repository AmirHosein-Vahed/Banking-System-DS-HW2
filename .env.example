# ---------------------------------------------------------------------------
# Docker Compose configuration (read by `docker compose -f deploy/compose.yaml`).
# Copy to `.env` and adjust; every value below is optional.
# ---------------------------------------------------------------------------

# Shared secret for internal service-to-service calls.
INTERNAL_TOKEN=dev-internal-token

# pino log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Balance given to every account by the bootstrap job (2000 accounts).
SEED_BALANCE=1000

# Concurrency limits (Assignment 1 §2.1).
GATEWAY_MAX_CONCURRENCY=200
SHARD_MAX_CONCURRENCY=100

# Replica health probing (gateway).
HEALTH_INTERVAL_MS=2000
HEALTH_TIMEOUT_MS=500
HEALTH_FAILURE_THRESHOLD=3

# Request timeouts.
SHARD_REQUEST_TIMEOUT_MS=5000
COORDINATOR_REQUEST_TIMEOUT_MS=20000
PREPARE_TIMEOUT_MS=5000

# Coordinator recovery sweep period.
RESOLVER_INTERVAL_MS=5000

# Demo-only fault injection. Leave empty for normal operation.
#   crash_after_prepare  - exit after every participant prepared (scenario B)
#   crash_after_decision - exit after the durable decision (scenario C)
FAULTS=

# ---------------------------------------------------------------------------
# Per-service variables below are set explicitly in deploy/compose.yaml. They
# are listed here for reference when running a service outside Docker.
# ---------------------------------------------------------------------------
# PORT=8080
# SHARD_MAP_PATH=./config/shard-map.yaml
# COORDINATOR_URL=http://localhost:8081
# SHARD_ID=A
# REPLICA_ID=a1
# DATABASE_URL=postgres://banking:banking@localhost:5432/banking
# COORDINATOR_DATABASE_URL=postgres://banking:banking@localhost:5432/banking
# DB_POOL_SIZE=10
# MIGRATIONS_DIR=./migrations
