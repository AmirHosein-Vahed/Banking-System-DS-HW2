{
  "name": "ds-banking-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed banking platform: sharding, replication and two-phase commit",
  "main": "dist/apps/gateway/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/unit",
    "test:unit": "vitest run test/unit",
    "test:integration": "RUN_INTEGRATION=1 vitest run test/integration",
    "test:watch": "vitest",
    "bootstrap": "tsx src/apps/bootstrap/main.ts",
    "gateway": "tsx src/apps/gateway/main.ts",
    "shard": "tsx src/apps/shard/main.ts",
    "coordinator": "tsx src/apps/coordinator/main.ts",
    "cli": "tsx src/apps/cli/main.ts",
    "lint": "eslint src test scripts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "fastify": "^5.4.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "dependency-cruiser": "^16.10.0",
    "eslint": "^9.30.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.0",
    "testcontainers": "^11.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
